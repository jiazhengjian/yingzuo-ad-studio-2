# 仅由本机后端读取，禁止在前端添加 VITE_* 密钥。
TUDOU_API_KEY=
PLANNER_PROVIDER=tudou
PLANNER_MODEL=gpt-6-sol
# 试验开关：同次起稿尚未证实稳定提速；默认保留前置内容稿。
JOINT_PLANNING_ENABLED=false
# 试验开关：内容初稿仅写实际台词与画面，完整动作与排时仍由分镜负责。
CONTENT_DRAFT_ENABLED=false
# 旁白候选：仅产品视觉展示+画外音；原始资料先写整段话，导演继续拿完整方向。
# 默认关闭，尚未完成自动路径的真实分镜和全审验证；不新增模型调用。
SPEECH_DRAFT_ENABLED=false
# 仅调整土豆 gpt-6-sol 的新版 storyboard 阶段，其他阶段按各自配置。
PLANNER_STORYBOARD_EFFORT=medium
# 旧 DeepSeek 配置仍兼容；仅在 PLANNER_PROVIDER=deepseek 时使用。
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
# 推荐快速配置：默认全部关闭。取消下面的注释并重启后，strategy 仍走上面的
# PLANNER_PROVIDER / PLANNER_MODEL；写稿、分镜、审核和返修改走 DeepSeek。
# 需要本机已有的 DEEPSEEK_API_KEY。这是可 A/B 的配置，不是已经测过的提速结果。
# 推理档位写入 reasoning_effort；方向审核档位只在该阶段仍使用土豆 gpt-6-sol 时生效。
# PLANNER_STAGE_ROUTES=ad_script=deepseek:deepseek-flash:low,script_review=deepseek:deepseek-flash:low,storyboard=deepseek:deepseek-flash:low,storyboard_repair=deepseek:deepseek-flash:low,alignment_review=deepseek:deepseek-flash:low,plan_review=deepseek:deepseek-flash:low,plan_refinement=deepseek:deepseek-flash:low,direction_review=deepseek:deepseek-flash:low
# PLANNER_FALLBACK_PROVIDER=deepseek
# PLANNER_FALLBACK_MODEL=deepseek-flash
# PLANNER_FALLBACK_ON=timeout,504
# PLANNER_STREAM=auto
# PLANNER_REQUEST_DEADLINE_SECONDS=270
# PLANNER_MAX_REFINEMENTS=1
# PLANNER_REFINEMENT_FORMAT=sparse
# PLANNER_DIRECTION_REVIEW_EFFORT=medium
# PLANNER_SPECULATE_RECOMMENDED=true
# 广告类型语速是工程容量，不是实测语速。不设置时：展示 3.0、剧情 3.8、口播 4.8 字/秒，
# 单拍 30/38/48 字。未分类型仍是 2.9 字/秒、单拍 29 字。降到 2.9 以下会让旧稿加载失败。
# AD_SPEECH_RATE_BRAND_TVC=3.0
# AD_BEAT_CHARS_BRAND_TVC=30
# AD_SPEECH_RATE_SCENE_STORY=3.8
# AD_BEAT_CHARS_SCENE_STORY=38
# AD_SPEECH_RATE_PRESENTER_PITCH=4.8
# AD_BEAT_CHARS_PRESENTER_PITCH=48
# 口号开关。默认 false：不写口号、不加结尾字卡。true 时只允许多一句不超过 10 字的收束口播。
# AD_TAGLINE_ENABLED=false
# 仅用于旧 voiceover 项目；新方案使用视频模型原生声音。
TTS_VOICE=Tingting
# 可选：AD_DATA_ROOT 指向独立的私有数据目录。留空配置行应删除或注释。
